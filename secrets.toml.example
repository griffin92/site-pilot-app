# Copy to .streamlit/secrets.toml locally, or paste into your host's
# secrets manager. NEVER commit the real secrets.toml to git.

GEMINI_API_KEY = "your-gemini-api-key"

# ---- Optional: Firebase (enables project persistence) ----
# The app runs fine without these -- projects just won't survive a restart.
# Paste the ENTIRE service-account JSON as a single-quoted string.
FIREBASE_SERVICE_ACCOUNT = '''
{
  "type": "service_account",
  "project_id": "your-project-id",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com",
  "client_id": "...",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "..."
}
'''

# Only needed for PDF + photo storage (requires Firebase Blaze plan).
# Firestore alone (project metadata, indexes, RFIs) works on the free Spark plan.
FIREBASE_STORAGE_BUCKET = "your-project-id.firebasestorage.app"
